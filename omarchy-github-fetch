#!/usr/bin/env bash
# Aggregate GitHub dashboard data for the Omarchy GitHub widget.
# Authentication is delegated entirely to the gh CLI credential store.
set -uo pipefail

action_scan="watch"
concurrency=6
mark_notifications=()
mark_dones=()
phase="all"
cache_file=""
watch_repos=()

usage() {
  cat <<'EOF'
Usage: omarchy-github-fetch [options]
  --action-scan MODE            off or watch (default: watch)
  --concurrency N               Concurrent Actions requests, 1-12 (default: 6)
  --mark-notification-read ID   Mark a notification thread read and exit
                                (repeatable; only the given IDs are patched)
  --mark-notification-done ID   Mark a notification thread done and exit
                                (repeatable; DELETE, not PATCH)
  --phase MODE                  all, inbox, or actions (default: all)
  --cache-file PATH             Write the emitted JSON to PATH (inbox creates,
                                actions merges into an existing file)
  --watch-repo OWNER/NAME       Repository to scan for Actions (repeatable).
                                Defaults to omacom/omarchy and
                                NetCask-Labs/NetCask-commercial, or
                                actionRepos in ~/.config/omarchy/github.json.
                                Owners are never expanded to every repository.
EOF
}

bool() { [[ ${1,,} == true || $1 == 1 || ${1,,} == yes || ${1,,} == on ]]; }
integer() { [[ $1 =~ ^[0-9]+$ ]]; }

while (($#)); do
  case "$1" in
    --action-scan) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; action_scan=${2,,}; shift 2 ;;
    --concurrency) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; concurrency=$2; shift 2 ;;
    --mark-notification-read) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; mark_notifications+=("$2"); shift 2 ;;
    --mark-notification-done) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; mark_dones+=("$2"); shift 2 ;;
    --phase) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; phase=${2,,}; shift 2 ;;
    --cache-file) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; cache_file=$2; shift 2 ;;
    --watch-repo) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; watch_repos+=("$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

integer "$concurrency" && ((concurrency >= 1 && concurrency <= 12)) || { echo "invalid --concurrency" >&2; exit 2; }
# recent/all remain accepted so leftover callers still scan the watch list.
[[ $action_scan == off || $action_scan == watch || $action_scan == recent || $action_scan == all ]] || { echo "invalid --action-scan" >&2; exit 2; }
[[ $phase == all || $phase == inbox || $phase == actions ]] || { echo "invalid --phase" >&2; exit 2; }

emit_state() {
  jq -n --arg state "$1" --arg message "$2" '{schemaVersion:1,state:$state,message:$message,login:"",fetchedAt:(now|todateiso8601),notifications:[],reviewRequests:[],assignedIssues:[],myPullRequests:[],myPullRequestsTotal:0,actions:[],failedActions:[],repositories:[],warnings:[],rateLimit:null}'
}

command -v jq >/dev/null 2>&1 || { printf '%s\n' '{"schemaVersion":1,"state":"error","message":"jq is required.","notifications":[],"reviewRequests":[],"assignedIssues":[],"myPullRequests":[],"myPullRequestsTotal":0,"actions":[],"failedActions":[],"repositories":[],"warnings":[]}' ; exit 0; }
# Host must be github.com or gist.github.com, then "/" or end of string, so
# github.com.evil.com cannot pass. Repo names are the GitHub character set only.
jq_github_url='def github_url: (if type == "string" then . else "" end) as $u | if ($u | test("(?i)^https://(gist\\.)?github\\.com(/|$)") and (test("[\\s\\\\]") | not)) then $u else "" end; def github_repo: (if type == "string" then . else "" end) as $n | if ($n | test("^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$")) then $n else "" end;'
safe_repo() { [[ $1 =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; }
if ((${#watch_repos[@]} == 0)); then
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/github.json"
  if [[ -f $cfg ]]; then
    mapfile -t watch_repos < <(jq -r '.actionRepos[]? // empty' "$cfg" 2>/dev/null)
  fi
fi
if ((${#watch_repos[@]} == 0)); then
  watch_repos=(omacom/omarchy NetCask-Labs/NetCask-commercial)
fi
resolved_watch=()
for repo in "${watch_repos[@]}"; do
  safe_repo "$repo" && resolved_watch+=("$repo")
done
watch_repos=("${resolved_watch[@]}")
if ((${#mark_notifications[@]} > 0)); then
  for id in "${mark_notifications[@]}"; do
    [[ $id =~ ^[0-9]+$ ]] || { jq -n --arg id "$id" '{state:"error",message:"Invalid notification thread id.",notificationId:$id}'; exit 2; }
  done
fi
if ((${#mark_dones[@]} > 0)); then
  for id in "${mark_dones[@]}"; do
    [[ $id =~ ^[0-9]+$ ]] || { jq -n --arg id "$id" '{state:"error",message:"Invalid notification thread id.",notificationId:$id}'; exit 2; }
  done
fi
if ((${#mark_notifications[@]} > 0 && ${#mark_dones[@]} > 0)); then
  jq -n '{state:"error",message:"Choose read or done, not both."}'
  exit 2
fi
command -v gh >/dev/null 2>&1 || { emit_state gh-not-installed "GitHub CLI is not installed or not on PATH."; exit 0; }
gh auth status -h github.com >/dev/null 2>&1 || { emit_state logged-out "Sign in with gh auth login to load GitHub data."; exit 0; }

error_detail() {
  tr '\n' ' ' <"$1" |
    sed -E 's/(gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})/[REDACTED]/g; s/(Authorization: *(token|Bearer) +)[^ ]+/\1[REDACTED]/Ig; s/[[:space:]]+/ /g; s/^ //; s/ $//' |
    cut -c1-240
}

# Only PATCH the confirmed thread IDs. Never PUT /notifications with
# last_read_at, which would mark threads the panel never displayed.
if ((${#mark_notifications[@]} > 0)); then
  if ! mark_tmp=$(mktemp -d); then
    jq -n --arg id "${mark_notifications[0]}" '{state:"error",message:"Could not prepare the notification request.",notificationId:$id}'
    exit 1
  fi
  trap 'rm -rf "$mark_tmp"' EXIT
  mark_one() {
    local id=$1
    if gh api --method PATCH "/notifications/threads/$id" >/dev/null 2>"$mark_tmp/$id.err"; then
      : >"$mark_tmp/$id.ok"
    fi
  }
  export mark_tmp
  export -f mark_one
  # Inbox size is tens to hundreds of threads; a serial gh process per ID
  # takes long enough that the panel looks stuck. Bounded parallelism keeps
  # each request independent without a last_read_at bulk write.
  printf '%s\n' "${mark_notifications[@]}" | xargs -r -P 6 -n 1 bash -c 'mark_one "$1"' _
  failed_id=""
  failed_message=""
  ok=0
  for id in "${mark_notifications[@]}"; do
    if [[ -f $mark_tmp/$id.ok ]]; then
      ok=$((ok + 1))
    elif [[ -z $failed_id ]]; then
      failed_id=$id
      failed_message=$(error_detail "$mark_tmp/$id.err")
    fi
  done
  rm -rf "$mark_tmp"
  trap - EXIT
  if [[ -n $failed_id ]]; then
    jq -n --arg id "$failed_id" --arg message "${failed_message:-Could not mark notification read.}" --argjson marked "$ok" '{state:"error",message:$message,notificationId:$id,marked:$marked}'
    exit 1
  fi
  if ((${#mark_notifications[@]} == 1)); then
    jq -n --arg id "${mark_notifications[0]}" '{state:"ready",message:"Notification marked read.",notificationId:$id}'
  else
    jq -n --argjson count "${#mark_notifications[@]}" '{state:"ready",message:"All displayed notifications marked read.",count:$count}'
  fi
  exit 0
fi

if ((${#mark_dones[@]} > 0)); then
  if ! mark_tmp=$(mktemp -d); then
    jq -n --arg id "${mark_dones[0]}" '{state:"error",message:"Could not prepare the notification request.",notificationId:$id}'
    exit 1
  fi
  trap 'rm -rf "$mark_tmp"' EXIT
  done_one() {
    local id=$1
    if gh api --method DELETE "/notifications/threads/$id" >/dev/null 2>"$mark_tmp/$id.err"; then
      : >"$mark_tmp/$id.ok"
    fi
  }
  export mark_tmp
  export -f done_one
  printf '%s\n' "${mark_dones[@]}" | xargs -r -P 6 -n 1 bash -c 'done_one "$1"' _
  failed_id=""
  failed_message=""
  ok=0
  for id in "${mark_dones[@]}"; do
    if [[ -f $mark_tmp/$id.ok ]]; then
      ok=$((ok + 1))
    elif [[ -z $failed_id ]]; then
      failed_id=$id
      failed_message=$(error_detail "$mark_tmp/$id.err")
    fi
  done
  rm -rf "$mark_tmp"
  trap - EXIT
  if [[ -n $failed_id ]]; then
    jq -n --arg id "$failed_id" --arg message "${failed_message:-Could not mark notification done.}" --argjson marked "$ok" '{state:"error",message:$message,notificationId:$id,marked:$marked}'
    exit 1
  fi
  if ((${#mark_dones[@]} == 1)); then
    jq -n --arg id "${mark_dones[0]}" '{state:"ready",message:"Notification marked done.",notificationId:$id}'
  else
    jq -n --argjson count "${#mark_dones[@]}" '{state:"ready",message:"Notifications marked done.",count:$count}'
  fi
  exit 0
fi

if ! tmp=$(mktemp -d); then
  emit_state error "Could not prepare temporary storage for the GitHub refresh."
  exit 1
fi
trap 'rm -rf "$tmp"' EXIT
warnings="$tmp/warnings"
: >"$warnings"
api_error() {
  local label=$1 err=$2 detail
  detail=$(error_detail "$err")
  [[ -n $detail ]] || detail="request failed"
  printf '%s: %s\n' "$label" "$detail" >>"$warnings"
}

fetch_paginated() {
  local label=$1 endpoint=$2 output=$3
  local err="$tmp/$label.err"
  if gh api --paginate -H 'Accept: application/vnd.github+json' "$endpoint" >"$output" 2>"$err"; then return 0; fi
  api_error "$label" "$err"
  return 1
}

fetch_inbox=true
fetch_actions=true
[[ $phase == actions ]] && fetch_inbox=false
[[ $phase == inbox ]] && fetch_actions=false

# Urgent inbox data is fetched independently so missing permissions in one
# section never suppress successful results in another.
if $fetch_inbox && fetch_paginated notifications '/notifications?all=false&participating=false&per_page=100' "$tmp/notifications.pages"; then
  # Notification subjects use API URLs whose path semantics vary by type.
  # Convert only known types and fall back to the repository for everything
  # else rather than opening an API endpoint or manufacturing a broken URL.
  jq -s "$jq_github_url"'[.[][] | select(.unread == true) |
    ((.repository.full_name // "") | github_repo) as $repo |
    (if ((.repository.html_url // "") | github_url) != "" then ((.repository.html_url) | github_url)
     elif $repo != "" then ("https://github.com/" + $repo)
     else "https://github.com/notifications" end) as $fallback |
    (.subject.url // "") as $api |
    {id:(.id // ""),reason:(.reason // ""),updatedAt:(.updated_at // ""),
     repository:$repo,title:(.subject.title // ""),type:(.subject.type // ""),
     url:(if .subject.type == "PullRequest" and ($api|test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/pulls/[0-9]+$")) then ($api|sub("^https://api.github.com/repos/";"https://github.com/")|sub("/pulls/";"/pull/")|github_url)
          elif .subject.type == "Issue" and ($api|test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/issues/[0-9]+$")) then ($api|sub("^https://api.github.com/repos/";"https://github.com/")|github_url)
          elif .subject.type == "Commit" and ($api|test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/commits/[0-9a-fA-F]+$")) then ($api|sub("^https://api.github.com/repos/";"https://github.com/")|sub("/commits/";"/commit/")|github_url)
          elif .subject.type == "Discussion" and ($api|test("^https://api\\.github\\.com/repos/[^/]+/[^/]+/discussions/[0-9]+$")) then ($api|sub("^https://api.github.com/repos/";"https://github.com/")|github_url)
          else $fallback end)}] | sort_by(.updatedAt) | reverse' "$tmp/notifications.pages" >"$tmp/notifications.json" 2>/dev/null || { printf '[]\n' >"$tmp/notifications.json"; printf '%s\n' 'notifications: invalid API response' >>"$warnings"; }
else printf '[]\n' >"$tmp/notifications.json"; fi

fetch_search() {
  local label=$1 query=$2 output=$3
  local pages="$tmp/$label.pages"
  if fetch_paginated "$label" "/search/issues?q=$query&per_page=100" "$pages"; then
    jq -s "$jq_github_url"'[.[] | .items[]? | {id:(.id|tostring),number,title:(.title // ""),repository:(.repository_url // "" | sub("^https://api.github.com/repos/";"") | github_repo),url:((.html_url // "") | github_url),updatedAt:(.updated_at // ""),user:(.user.login // ""),draft:(.draft // false)}] | sort_by(.updatedAt) | reverse' "$pages" >"$output" 2>/dev/null || { printf '[]\n' >"$output"; printf '%s: invalid API response\n' "$label" >>"$warnings"; }
  else printf '[]\n' >"$output"; fi
}
# Pull-request search is GraphQL so check rollup and review counts arrive with
# the row. latestReviews is one review per person; approved + still-requested
# is the n/m denominator. Reviewer logins stay out of the payload on purpose.
pr_search_query='query($search:String!) { search(query:$search,type:ISSUE,first:50) { issueCount nodes { ... on PullRequest { number title url updatedAt isDraft reviewDecision latestReviews(first:20) { nodes { state } } reviewRequests { totalCount } repository { nameWithOwner } commits(last:1) { nodes { commit { statusCheckRollup { state } } } } } } } }'
jq_pr_nodes="$jq_github_url"'
def review_stats:
  ((.latestReviews.nodes // []) | map(select(.state == "APPROVED")) | length) as $approved
  | ((.latestReviews.nodes // []) | map(select(.state == "CHANGES_REQUESTED")) | length) as $changes
  | ((.reviewRequests.totalCount // 0)) as $pending
  | {approved:$approved, requested:($approved + $pending), changesRequested:($changes > 0 or .reviewDecision == "CHANGES_REQUESTED")};
[.data.search.nodes[] | select(.number != null) |
  ((.repository.nameWithOwner // "") | github_repo) as $repo |
  review_stats as $r |
  {id:($repo + "#" + (.number|tostring)),number,title:(.title // ""),
   repository:$repo,url:((.url // "") | github_url),updatedAt:(.updatedAt // ""),
   draft:(.isDraft // false),checks:(.commits.nodes[0].commit.statusCheckRollup.state // "NONE"),
   approved:$r.approved, requested:$r.requested, changesRequested:$r.changesRequested}]
| sort_by(.updatedAt) | reverse'

fetch_pr_search() {
  local label=$1 query=$2 list_out=$3 total_out=$4
  local raw err
  err="$tmp/$label.err"
  printf '[]\n' >"$list_out"
  [[ -n $total_out ]] && printf '0\n' >"$total_out"
  if ! raw=$(gh api graphql -f query="$pr_search_query" -F search="$query" 2>"$err"); then
    api_error "$label" "$err"
    return 1
  fi
  # A pull request with no configured workflows reports a null rollup, which is
  # a distinct state from pending and must not be rendered as one.
  printf '%s\n' "$raw" | jq "$jq_pr_nodes" >"$list_out" 2>/dev/null || { printf '[]\n' >"$list_out"; printf '%s: invalid API response\n' "$label" >>"$warnings"; }
  if [[ -n $total_out ]]; then
    printf '%s\n' "$raw" | jq '.data.search.issueCount // 0' >"$total_out" 2>/dev/null || printf '0\n' >"$total_out"
  fi
}

if $fetch_inbox; then
fetch_search assigned-issues "is%3Aopen+is%3Aissue+assignee%3A%40me+archived%3Afalse" "$tmp/issues.json"
fetch_pr_search review-requests "is:open is:pr review-requested:@me sort:updated-desc draft:false archived:false" "$tmp/reviews.json" ""
fetch_pr_search my-pull-requests "is:open is:pr author:@me sort:updated-desc archived:false" "$tmp/mypulls.json" "$tmp/mypulls-total.json"
else
  printf '[]\n' >"$tmp/reviews.json"
  printf '[]\n' >"$tmp/issues.json"
  printf '[]\n' >"$tmp/mypulls.json"
  printf '0\n' >"$tmp/mypulls-total.json"
fi

[[ -n ${login:-} ]] || login=$(gh api user -q .login 2>/dev/null || true)
printf '[]\n' >"$tmp/repos.json"
printf '[]\n' >"$tmp/actions.json"
printf '[]\n' >"$tmp/failed.json"
printf 'null\n' >"$tmp/rate.json"
if $fetch_actions && [[ $action_scan != off && ${#watch_repos[@]} -gt 0 ]]; then
  printf '%s\n' "${watch_repos[@]}" >"$tmp/scan-repos"
  jq -n --args '$ARGS.positional | map({nameWithOwner:., url:("https://github.com/" + .)})' -- "${watch_repos[@]}" >"$tmp/repos.json"
  scan_one() {
    local repo=$1 key prefix status failed=false
    safe_repo "$repo" || return 0
    key=$(printf '%s' "$repo"|sha256sum|cut -d' ' -f1); prefix="$tmp/action-$key"
    : >"$prefix.active.pages"; : >"$prefix.completed.pages"; : >"$prefix.err"
    for status in in_progress queued waiting requested pending; do
      if ! gh api -H 'Accept: application/vnd.github+json' "/repos/$repo/actions/runs?status=$status&per_page=20" >>"$prefix.active.pages" 2>>"$prefix.err"; then failed=true; fi
    done
    if ! gh api -H 'Accept: application/vnd.github+json' "/repos/$repo/actions/runs?status=completed&per_page=10" >"$prefix.completed.pages" 2>>"$prefix.err"; then failed=true; fi
    jq -s --arg repo "$repo" "$jq_github_url"'[.[]|.workflow_runs[]?|select(.status=="in_progress" or .status=="queued" or .status=="waiting" or .status=="requested" or .status=="pending")|{id,repository:$repo,name:(.name // .display_title // "Workflow"),title:(.display_title // ""),status:(.status // ""),conclusion:(.conclusion // ""),event:(.event // ""),branch:(.head_branch // ""),url:((.html_url // "") | github_url),createdAt:(.created_at // ""),updatedAt:(.updated_at // ""),job:"",step:"",jobs:[]}]|unique_by(.id)' "$prefix.active.pages" >"$prefix.active.json" 2>/dev/null || printf '[]\n' >"$prefix.active.json"
    jq -s --arg repo "$repo" "$jq_github_url"'[.[]|.workflow_runs[]?|select(.conclusion=="failure" or .conclusion=="timed_out" or .conclusion=="action_required" or .conclusion=="startup_failure")|{id,repository:$repo,name:(.name // .display_title // "Workflow"),title:(.display_title // ""),status:(.status // ""),conclusion:(.conclusion // ""),event:(.event // ""),branch:(.head_branch // ""),url:((.html_url // "") | github_url),createdAt:(.created_at // ""),updatedAt:(.updated_at // "")}]|unique_by(.id)|sort_by(.updatedAt)|reverse|.[0:1]' "$prefix.completed.pages" >"$prefix.completed.json" 2>/dev/null || printf '[]\n' >"$prefix.completed.json"
    if [[ $failed == true ]]; then api_error "actions $repo" "$prefix.err"; fi
  }
  export tmp warnings jq_github_url; export -f scan_one api_error error_detail safe_repo
  xargs -r -P "$concurrency" -I{} bash -c 'scan_one "$1"' _ {} <"$tmp/scan-repos"
  jq -s 'add // []|unique_by(.id)|sort_by(.createdAt)|reverse' "$tmp"/action-*.active.json >"$tmp/actions.json" 2>/dev/null || printf '[]\n' >"$tmp/actions.json"
  jq -s 'add // []|unique_by(.id)|sort_by(.updatedAt)|reverse' "$tmp"/action-*.completed.json >"$tmp/failed.json" 2>/dev/null || printf '[]\n' >"$tmp/failed.json"
  if [[ -s $tmp/actions.json && $(jq 'length' "$tmp/actions.json") -gt 0 ]]; then
    jq -r '.[] | select(.status=="in_progress" or .status=="queued") | select(.id != null) | (.repository|tostring) + "\t" + (.id|tostring)' "$tmp/actions.json" | head -20 >"$tmp/job-runs"
    : >"$tmp/jobmeta.jsonl"
    while IFS=$'\t' read -r repo run; do
      [[ $run =~ ^[0-9]+$ ]] || continue
      safe_repo "$repo" || continue
      if jobs_json=$(gh api -H 'Accept: application/vnd.github+json' "/repos/$repo/actions/runs/$run/jobs?per_page=100" 2>>"$tmp/jobs.err"); then
        printf '%s\n' "$jobs_json" | jq -c --argjson run "$run" --arg repo "$repo" '{id:$run,repository:$repo,job:(([.jobs[]? | select(.status=="in_progress" or .status=="queued" or .status=="waiting")][0].name) // ""),step:(([.jobs[]? | select(.status=="in_progress") | (.steps // [])[] | select(.status=="in_progress")][0].name) // ""),jobs:([.jobs[]? | {name:(.name // "job"),status:(.status // ""),conclusion:(.conclusion // "")}])}' >>"$tmp/jobmeta.jsonl"
      fi
    done < "$tmp/job-runs"
    if [[ -s $tmp/jobmeta.jsonl ]]; then
      jq -s '.' "$tmp/jobmeta.jsonl" >"$tmp/jobmeta.json"
      jq --slurpfile meta "$tmp/jobmeta.json" '($meta[0] // []) as $m | map(. as $a | ($m | map(select((.id|tostring) == ($a.id|tostring) and .repository == $a.repository))[0] // {}) as $hit | . + {job:($hit.job // ""), step:($hit.step // ""), jobs:($hit.jobs // [])})' "$tmp/actions.json" >"$tmp/actions.jobs" && mv "$tmp/actions.jobs" "$tmp/actions.json"
    fi
  fi
fi

warnings_json=$(sort -u "$warnings"|jq -Rsc 'split("\n")|map(select(length>0))')
state=ready
message=""
if grep -qiE 'rate.?limit|secondary rate' "$warnings"; then state=rate-limited; message="GitHub API rate limit reached."; fi
json=$(jq -n --arg state "$state" --arg message "$message" --arg login "${login:-}" --arg phase "$phase" --slurpfile notifications "$tmp/notifications.json" --slurpfile reviews "$tmp/reviews.json" --slurpfile issues "$tmp/issues.json" --slurpfile mypulls "$tmp/mypulls.json" --slurpfile mypullstotal "$tmp/mypulls-total.json" --slurpfile actions "$tmp/actions.json" --slurpfile failed "$tmp/failed.json" --slurpfile repositories "$tmp/repos.json" --argjson warnings "$warnings_json" --slurpfile rate "$tmp/rate.json" '{schemaVersion:1,phase:$phase,state:$state,message:$message,login:$login,fetchedAt:(now|todateiso8601),notifications:$notifications[0],reviewRequests:$reviews[0],assignedIssues:$issues[0],myPullRequests:$mypulls[0],myPullRequestsTotal:$mypullstotal[0],actions:$actions[0],failedActions:$failed[0],repositories:$repositories[0],warnings:$warnings,rateLimit:$rate[0]}')
printf '%s\n' "$json"
if [[ -n $cache_file ]]; then
  mkdir -p "$(dirname "$cache_file")"
  if [[ $phase == actions && -f $cache_file ]]; then
    printf '%s\n' "$json" >"$tmp/incoming.json"
    jq -s '.[0] as $old | .[1] as $new | $old + {actions:$new.actions, failedActions:$new.failedActions, repositories:$new.repositories, rateLimit:$new.rateLimit, warnings:((($old.warnings // []) + ($new.warnings // [])) | unique), actionsFetchedAt:$new.fetchedAt, phase:"all"}' "$cache_file" "$tmp/incoming.json" >"$cache_file.next" && mv "$cache_file.next" "$cache_file"
  else
    printf '%s\n' "$json" >"$cache_file"
  fi
fi
